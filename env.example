TELEGRAM_BOT_TOKEN=your_bot_token_here
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/velocity_bingo?retryWrites=true&w=majority

# Primary bot owner Telegram user ID (backward-compatible single-owner option)
OWNER_ID=123456789

# Optional multiple-owner list. Separate IDs with commas or semicolons.
# Every ID can use owner-only commands such as /broadcast, /give, and tournaments.
# Example: OWNER_IDS=123456789,987654321;555555555
OWNER_IDS=123456789,987654321

# Group/channel ID where bot logs are sent (optional)
# Get by adding the bot to the group and checking its ID
LOGGER_GROUP_ID=-1001234567890

# Support channel URL shown as inline button on turn panels (optional)
SUPPORT_CHANNEL=https://t.me/yourchannel


# Tournament settings
TOURNAMENT_GROUP_ID=-1001234567890
TOURNAMENT_CHANNEL=@your_official_channel
OWNER_CONTACT_URL=https://t.me/your_username

# Tournament commands are owner-only. A tournament is created in the group where
# /tournament create is run, so no extra tournament group variable is required.
# At most this many tournament matches run at the same time (default: 8).
TOURNAMENT_MAX_CONCURRENT_MATCHES=8

# Optional welcome/help photos
START_PHOTO_URL=
HELP_PHOTO_URL=
